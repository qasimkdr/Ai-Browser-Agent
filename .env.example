GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
MAX_STEPS=100
BROWSER_SLOW_MO=80

# Required for automated form workflows. Use only domains you own or are authorized to test.
ALLOWED_DOMAINS=staging.example.com

# Strongly recommended. Required before stored test credentials can be exported.
DASHBOARD_TOKEN=change-me-to-a-long-random-token

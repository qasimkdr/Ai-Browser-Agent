GEMINI_API_KEY=your_gemini_key_here
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
MAX_STEPS=100
BROWSER_SLOW_MO=80
# Optional comma-separated allowlist for authorized target domains.
# ALLOWED_DOMAINS=example.com,staging.example.com
# Optional dashboard API token. If set, the UI asks for it and stores it locally.
# DASHBOARD_TOKEN=change-me
